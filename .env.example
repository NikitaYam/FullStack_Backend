DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookapp
DB_USER=postgres
DB_PASSWORD=chancge_me
CORS_ORIGINS=["http://localhost:5173"]

# Секрет подписи JWT, минимум 32 символа. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_random_string_of_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# true при работе по HTTPS: cookie с refresh token будет передаваться только по защищённому соединению
COOKIE_SECURE=false